# Copy this file to .env and replace every placeholder before starting Compose.
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Use a long, random signing key (at least 32 characters).
JWT_KEY=replace-with-a-long-random-jwt-signing-key
JWT_ISSUER=PadelBooking.Api
JWT_AUDIENCE=PadelBooking.Client

# Optional SMTP settings. Keep real credentials only in the untracked .env file.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=PadelBooking
EMAIL_USE_SSL=false
