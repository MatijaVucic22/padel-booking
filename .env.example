# Copy this file to .env and replace every placeholder before starting either development mode.
MYSQL_DATABASE=padel_booking
MYSQL_USER=padel_user
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Use a long, random signing key (at least 32 characters).
JWT_KEY=replace-with-a-long-random-jwt-signing-key
JWT_ISSUER=PadelBooking.Api
JWT_AUDIENCE=PadelBooking.Client

# Stripe TEST mode only. Keep real test secrets in the untracked .env file.
STRIPE_SECRET_KEY=replace-with-your-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-test-webhook-secret
STRIPE_FRONTEND_URL=http://localhost:5173

# Optional SMTP settings. Keep real credentials only in the untracked .env file.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=PadelBooking
EMAIL_USE_SSL=false
